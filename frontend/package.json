{
  "name": "fair-game",
  "description": "The frontend to FairGame",
  "author": {
    "email": "kaliburg@pm.me",
    "name": "Tobias Schmidt",
    "url": "https://fair.kaliburg.de"
  },
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare",
    "prepare": "cd .. && husky install frontend/.husky",
    "lintfix": "eslint --fix .",
    "clean": "rm -rf node_modules ; rm -rf .nuxt ; rm -rf .output ; rm -rf dist",
    "clean::win": "rd /s /q node_modules & rd /s /q .nuxt & rd /s /q .output & rd /s /q dist",
    "clean-install": "pnpm run clean ; pnpm install",
    "clean-install::win": "pnpm run clean::win & pnpm install",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:bench": "vitest run --config vitest.bench.config.mts",
    "test:e2e": "vitest --run --config vitest.e2e.config.mts"
  },
  "devDependencies": {
    "@antfu/utils": "^0.7.5",
    "@commitlint/cli": "^17.1.2",
    "@commitlint/config-conventional": "^17.1.0",
    "@floating-ui/dom": "^1.8.0",
    "@fortawesome/fontawesome-svg-core": "^6.2.0",
    "@fortawesome/free-brands-svg-icons": "^6.2.0",
    "@fortawesome/free-regular-svg-icons": "^6.2.0",
    "@fortawesome/free-solid-svg-icons": "^6.2.0",
    "@fortawesome/vue-fontawesome": "^3.0.1",
    "@headlessui/vue": "^1.6.7",
    "@heroicons/vue": "^2.0.17",
    "@microsoft/eslint-formatter-sarif": "^3.0.0",
    "@nuxt/content": "^3.16.2",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.3",
    "@pinia/testing": "^2.0.2",
    "@stomp/stompjs": "^7.0.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-mention": "3.32.0",
    "@tiptap/extension-paragraph": "3.32.0",
    "@tiptap/extension-text": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/suggestion": "3.32.0",
    "@tiptap/vue-3": "3.32.0",
    "@types/intro.js": "^5.1.0",
    "@types/js-cookie": "^3.0.2",
    "@types/node": "^22.20.5",
    "@types/sockjs-client": "^1.5.1",
    "@types/ws": "^8.5.5",
    "@vue/devtools-api": "^8.2.1",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "@zxcvbn-ts/core": "^3.0.2",
    "@zxcvbn-ts/language-common": "^3.0.3",
    "@zxcvbn-ts/language-en": "^3.0.1",
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "break_infinity.js": "^2.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "happy-dom": "^21.0.4",
    "husky": "^8.0.1",
    "intro.js": "^6.0.0",
    "js-cookie": "^3.0.1",
    "lint-staged": "^13.0.3",
    "nuxt": "^4.6.2",
    "pinia": "^4.1.0",
    "playwright": "^1.58.2",
    "postcss": "^8.4.31",
    "postcss-loader": "^7.0.2",
    "prettier": "^3.0.3",
    "prettier-plugin-tailwindcss": "^0.5.4",
    "sass": "^1.54.8",
    "sass-loader": "^13.0.2",
    "swarm-numberformat": "^0.4.0",
    "tailwindcss": "^3.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue": "^3.2.38",
    "vue-i18n": "^11.4.8",
    "vue-tippy": "^6.0.0",
    "vue-tsc": "^3.3.13",
    "vue-virtual-scroller": "2.0.0-beta.8",
    "vue3-toastify": "^0.1.8",
    "webpack": "^5.74.0",
    "ws": "^8.13.0"
  },
  "lint-staged": {
    "**/*.{js,ts,vue,html}": [
      "pnpm lintfix"
    ]
  }
}
