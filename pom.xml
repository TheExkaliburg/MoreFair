<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.kaliburg</groupId>
    <artifactId>fairgame</artifactId>
    <version>1.0</version>
    <packaging>pom</packaging>

    <name>FairGame</name>
    <description>A competitive/cooperative Ladder Game</description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <properties>
        <main.basedir>${project.basedir}</main.basedir>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>21</java.version>
        <!-- Temporary compiler plugin security upgrade beyond Spring Boot's managed version.
             Remove this override once the Spring Boot parent manages this version or newer. -->
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
    </properties>

    <profiles>
        <profile>
            <id>debug</id>
            <modules>
                <module>backend</module>
            </modules>
        </profile>
        <profile>
            <id>default</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <modules>
                <module>frontend</module>
                <module>backend</module>
            </modules>
        </profile>
    </profiles>
</project>
